{
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "node -e \"try{require('fs').unlinkSync('public/hot')}catch(e){}\" && vite build",
        "tauri": "tauri",
        "clean:tauri-resources": "node -e \"const fs=require('fs'); for (const d of ['src-tauri/target/release/laravel','src-tauri/target/release/php']) fs.rmSync(d,{recursive:true,force:true});\"",
        "tauri:build:prod": "npm run clean:tauri-resources && tauri build --config src-tauri/tauri.prod.conf.json"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/typography": "^0.5.0",
        "@tauri-apps/cli": "^2.11.4",
        "autoprefixer": "^10.4.7",
        "axios": "^1.6.4",
        "laravel-vite-plugin": "^1.0.0",
        "postcss": "^8.4.14",
        "tailwindcss": "^3.1.0",
        "vite": "^5.0.0"
    },
    "dependencies": {
        "hotkeys-js": "^3.13.10",
        "@tauri-apps/plugin-updater": "^2",
        "@tauri-apps/plugin-process": "^2"
    }
}
